{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "../Bot Appetit"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.dev.vars)",
      "Read(./**/dist/**)",
      "Read(./**/build/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "gsap-skills": {
      "source": {
        "source": "github",
        "repo": "greensock/gsap-skills"
      }
    }
  },
  "enabledPlugins": {
    "gsap-skills@gsap-skills": true
  }
}
